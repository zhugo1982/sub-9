#!/bin/bash
# Hugo sing-box 11协议一键管理脚本（改进版）

if [ "$EUID" -ne 0 ]; then
  echo "❌ 请使用 root 权限运行！"
  exit 1
fi

LOG_FILE="/etc/sing-box/sub_links.txt"
SUB_FILE="/etc/sing-box/sub_b64.txt"
SB_JSON_FILE="/etc/sing-box/sub_singbox.json"
SUB_PORT=2082

# 自动放行防火墙
open_firewall() {
  echo "==> 正在放行必要端口..."
  PORTS_TCP="443 444 8881 3443 10000 8443 9443 6443 6555 7443 5443 $SUB_PORT"
  PORTS_UDP="8443 9443"

  if command -v ufw >/dev/null 2>&1; then
    ufw allow 22/tcp >/dev/null 2>&1
    for p in $PORTS_TCP; do ufw allow $p/tcp >/dev/null 2>&1; done
    for p in $PORTS_UDP; do ufw allow $p/udp >/dev/null 2>&1; done
    ufw --force enable >/dev/null 2>&1
    echo "✅ ufw 已放行端口"
  elif command -v firewall-cmd >/dev/null 2>&1; then
    for p in $PORTS_TCP; do firewall-cmd --permanent --add-port=$p/tcp >/dev/null 2>&1; done
    for p in $PORTS_UDP; do firewall-cmd --permanent --add-port=$p/udp >/dev/null 2>&1; done
    firewall-cmd --reload >/dev/null 2>&1
    echo "✅ firewalld 已放行端口"
  else
    echo "⚠️  未检测到 ufw/firewalld，请手动在云厂商安全组放行以下端口："
    echo "   TCP: $PORTS_TCP"
    echo "   UDP: $PORTS_UDP"
  fi
}

show_nodes() {
  if [ -f "$LOG_FILE" ]; then
    echo "============================================================"
    echo "✨ 当前服务器已生成的 11 大协议节点信息："
    echo "============================================================"
    cat "$LOG_FILE"
    echo ""
    echo "============================================================"
    echo "🔗 通用订阅 (V2rayN / Shadowrocket / v2rayNG):"
    echo "   http://$(curl -s https://api.ipify.org || echo "你的IP"):$SUB_PORT/sub"
    echo ""
    echo "🍎 Apple / sing-box 专用 JSON 订阅:"
    echo "   http://$(curl -s https://api.ipify.org || echo "你的IP"):$SUB_PORT/singbox"
    echo "============================================================"
  else
    echo "❌ 未找到节点信息，请先运行全新部署。"
  fi
}

setup_sub_service() {
  echo "==> 配置订阅托管服务..."
  if ! command -v python3 >/dev/null 2>&1; then
    apt-get update -y >/dev/null 2>&1 && apt-get install -y python3 >/dev/null 2>&1 || yum install -y python3 >/dev/null 2>&1
  fi

  cat > /etc/sing-box/sub_server.py << 'PY'
import http.server, socketserver, os
PORT=2082
class H(http.server.SimpleHTTPRequestHandler):
    def do_GET(self):
        if self.path=='/sub':
            f="/etc/sing-box/sub_b64.txt"
            if os.path.exists(f):
                self.send_response(200)
                self.send_header('Content-type','text/plain; charset=utf-8')
                self.end_headers()
                self.wfile.write(open(f,'rb').read())
            else: self.send_error(404)
        elif self.path in ('/singbox','/sb'):
            f="/etc/sing-box/sub_singbox.json"
            if os.path.exists(f):
                self.send_response(200)
                self.send_header('Content-type','application/json; charset=utf-8')
                self.end_headers()
                self.wfile.write(open(f,'rb').read())
            else: self.send_error(404)
        else: self.send_error(403)
    def log_message(self,*a): pass
if __name__=="__main__":
    socketserver.TCPServer.allow_reuse_address=True
    with socketserver.TCPServer(("",PORT),H) as httpd: httpd.serve_forever()
PY

  cat > /etc/systemd/system/hugo-sub.service << 'SVC'
[Unit]
Description=Hugo Sub HTTP Service
After=network.target
[Service]
Type=simple
ExecStart=/usr/bin/python3 /etc/sing-box/sub_server.py
Restart=always
User=root
[Install]
WantedBy=multi-user.target
SVC

  systemctl daemon-reload
  systemctl enable hugo-sub --now >/dev/null 2>&1
  echo "✅ 订阅服务已启动"
}

uninstall_nodes() {
  echo "============================================================"
  echo "⚠️  警告：将彻底卸载 sing-box 和所有节点！"
  read -p "确定卸载吗？(y/N): " c
  case "$c" in
    [yY]|[yY][eE][sS])
      systemctl stop sing-box hugo-sub 2>/dev/null
      systemctl disable sing-box hugo-sub 2>/dev/null
      rm -rf /etc/sing-box
      rm -f /etc/systemd/system/hugo-sub.service
      systemctl daemon-reload
      command -v apt-get >/dev/null && apt-get purge -y sing-box >/dev/null 2>&1
      command -v yum >/dev/null && yum remove -y sing-box >/dev/null 2>&1
      rm -f /usr/local/bin/sub
      echo "✅ 卸载完成"
      exit 0
      ;;
    *) echo "已取消" ;;
  esac
}

install_nodes() {
  echo "==> 0. 检查并安装 sing-box..."
  if ! command -v sing-box >/dev/null 2>&1; then
    apt-get update -y >/dev/null 2>&1
    apt-get install -y curl wget jq openssl python3 >/dev/null 2>&1 || yum install -y curl wget jq openssl python3 >/dev/null 2>&1
    bash <(curl -fsSL https://sing-box.app/deb-install.sh)
    echo "✅ sing-box 安装完成"
  else
    echo "✅ sing-box 已存在"
  fi

  open_firewall

  echo "==> 1. 停止旧服务..."
  systemctl stop sing-box 2>/dev/null

  echo "==> 2. 生成凭证..."
  mkdir -p /etc/sing-box

  KEYPAIR=$(sing-box generate reality-keypair)
  PRIV_KEY=$(echo "$KEYPAIR" | grep PrivateKey | awk '{print $2}')
  PUB_KEY=$(echo "$KEYPAIR" | grep PublicKey | awk '{print $2}')

  UUID=$(cat /proc/sys/kernel/random/uuid)
  VMESS_UUID=$(cat /proc/sys/kernel/random/uuid)
  ANYTLS_PASS=$(cat /proc/sys/kernel/random/uuid)
  HY2_PASS=$(cat /proc/sys/kernel/random/uuid | cut -d- -f1)
  TUIC_PASS=$(cat /proc/sys/kernel/random/uuid)
  SS_PASS=$(openssl rand -base64 16)
  SS_CLASSIC_PASS=$(openssl rand -base64 16)
  TROJAN_PASS=$(cat /proc/sys/kernel/random/uuid | cut -d- -f1)
  PROXY_USER="hugo"
  PROXY_PASS=$(openssl rand -hex 6)
  SHORT_ID="0123456789abcdef"
  # 使用更稳定的 SNI
  SNI="www.microsoft.com"

  IP=$(curl -s --connect-timeout 5 https://api.ipify.org)
  [ -z "$IP" ] && IP=$(curl -s --connect-timeout 5 https://ifconfig.me)
