      "listen": "::",
      "listen_port": 6443,
      "method": "2022-blake3-aes-128-gcm",
      "password": "$SS_PASS"
    },
    {
      "type": "shadowsocks",
      "tag": "ss-classic-in",
      "listen": "::",
      "listen_port": 6555,
      "method": "aes-256-gcm",
      "password": "$SS_CLASSIC_PASS"
    },
    {
      "type": "trojan",
      "tag": "trojan-in",
      "listen": "::",
      "listen_port": 7443,
      "users": [{"name": "hugo-trojan", "password": "$TROJAN_PASS"}],
      "tls": {
        "enabled": true,
        "certificate_path": "/etc/sing-box/hy2.crt",
        "key_path": "/etc/sing-box/hy2.key"
      }
    },
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "::",
      "listen_port": 5443,
