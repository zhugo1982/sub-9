  echo ""
  echo "✅ 部署完成！"
  echo ""
  show_nodes
  echo ""
  echo "【重要提示】"
  echo "1. 请务必在云厂商控制台安全组放行上述 TCP/UDP 端口"
  echo "2. 如果节点仍然全是 -1，执行以下命令排查："
  echo "   systemctl status sing-box"
  echo "   journalctl -u sing-box -n 50 --no-pager"
  echo "   ss -tulnp | grep sing-box"
}

# 主逻辑
if [ "$1" = "install" ] || [ "$1" = "2" ]; then
  install_nodes
  exit 0
fi
if [ "$1" = "uninstall" ] || [ "$1" = "3" ]; then
  uninstall_nodes
  exit 0
fi

echo "============================================================"
echo "          Hugo sing-box 多协议一键管理脚本（改进版）"
echo "============================================================"
echo "  1. 查看当前节点信息及订阅链接"
echo "  2. 全新部署 / 重置 11 大协议节点"
echo "  3. 彻底卸载 sing-box 及清除所有服务"
echo "  0. 退出"
echo "============================================================"
read -p "请输入数字选择 [0-3]: " CHOICE

case "$CHOICE" in
  1) show_nodes ;;
  2) install_nodes ;;
  3) uninstall_nodes ;;
  0) exit 0 ;;
  *) echo "❌ 无效输入"; exit 1 ;;
esac
