# 部署并启动轻量级 HTTP 订阅托管服务
setup_sub_service() {
    echo "==> 配置 HTTP 订阅托管服务 (端口: $SUB_PORT)..."
    
    # 确保安装 python3
    if ! command -v python3 &> /dev/null; then
        apt-get update -y && apt-get install -y python3 2>/dev/null || yum install -y python3 2>/dev/null
    fi

    # 编写后台轻量 HTTP 订阅服务脚本
    cat > /etc/sing-box/sub_server.py << 'PYEOF'
import http.server
import socketserver
import os

PORT = 2082
SUB_B64 = "/etc/sing-box/sub_b64.txt"
SUB_SB  = "/etc/sing-box/sub_singbox.json"

class SubHandler(http.server.SimpleHTTPRequestHandler):
    def do_GET(self):
        if self.path == '/sub':
            if os.path.exists(SUB_B64):
                self.send_response(200)
                self.send_header('Content-type', 'text/plain; charset=utf-8')
                self.end_headers()
                with open(SUB_B64, 'rb') as f:
                    self.wfile.write(f.read())
            else:
                self.send_error(404, "Subscription File Not Found")
        elif self.path == '/singbox' or self.path == '/sb':
            if os.path.exists(SUB_SB):
                self.send_response(200)
                self.send_header('Content-type', 'application/json; charset=utf-8')
                self.end_headers()
                with open(SUB_SB, 'rb') as f:
                    self.wfile.write(f.read())
            else:
                self.send_error(404, "Sing-box JSON Not Found")
        else:
            self.send_error(403, "Access Denied")

    def log_message(self, format, *args):
        return

if __name__ == "__main__":
    socketserver.TCPServer.allow_reuse_address = True
    with socketserver.TCPServer(("", PORT), SubHandler) as httpd:
        httpd.serve_forever()
PYEOF

    # 创建 systemd 开机自启服务
    cat > /etc/systemd/system/hugo-sub.service << SERVICEOF
[Unit]
Description=Hugo Sub HTTP Service
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /etc/sing-box/sub_server.py
Restart=always
User=root

[Install]
WantedBy=multi-user.target
SERVICEOF

    systemctl daemon-reload
    systemctl enable hugo-sub
    systemctl restart hugo-sub
    echo "✅ 订阅托管服务已启动！"
}

# 完全卸载/清理函数
uninstall_nodes() {
    echo "============================================================"
    echo "⚠️  警告：此操作将彻底卸载 sing-box、订阅服务并删除所有节点配置！"
    read -p "确定要彻底卸载吗？(y/N): " CONFIRM
    case "$CONFIRM" in
        [yY][eE][sS]|[yY])
            echo "==> 1. 停止并禁用服务..."
            systemctl stop sing-box 2>/dev/null
            systemctl disable sing-box 2>/dev/null
            systemctl stop hugo-sub 2>/dev/null
            systemctl disable hugo-sub 2>/dev/null
            echo "==> 2. 清理配置文件与订阅开机项..."
            rm -rf /etc/sing-box
            rm -f /etc/systemd/system/hugo-sub.service
            systemctl daemon-reload
            echo "==> 3. 卸载 sing-box 软件包..."
            if command -v apt-get &> /dev/null; then
                apt-get purge -y sing-box 2>/dev/null
                apt-get autoremove -y 2>/dev/null
            elif command -v yum &> /dev/null; then
                yum remove -y sing-box 2>/dev/null
            fi
            echo "==> 4. 清理 sub 全局快捷键..."
            rm -f /usr/local/bin/sub
            echo "============================================================"
            echo "✅ 卸载完成！所有节点、订阅 HTTP 服务及残留文件已彻底清理。"
            echo "============================================================"
            exit 0
            ;;
        *)
            echo "❌ 操作已取消。"
            ;;
    esac
}

