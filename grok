# 显示当前已保存节点及订阅信息的函数
show_nodes() {
    if [ -f "$LOG_FILE" ]; then
        echo "============================================================"
        echo "✨ 当前服务器已生成的 11 大协议节点信息如下："
        echo "============================================================"
        cat "$LOG_FILE"
        echo ""
        echo "============================================================"
