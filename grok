  openssl req -x509 -nodes -newkey rsa:2048 \
    -keyout /etc/sing-box/hy2.key \
    -out /etc/sing-box/hy2.crt \
    -days 3650 -subj "/CN=bing.com" 2>/dev/null

  echo "==> 4. 启动 sing-box..."
  systemctl enable sing-box >/dev/null 2>&1
  systemctl restart sing-box
  sleep 2

  # 检查服务状态
  if systemctl is-active --quiet sing-box; then
    echo "✅ sing-box 服务运行正常"
  else
    echo "❌ sing-box 启动失败！请查看日志: journalctl -u sing-box -n 30 --no-pager"
    return 1
  fi

  # 检查监听端口
  echo "==> 检查监听端口..."
  ss -tulnp | grep -E ':(443|444|8881|3443|10000|8443|9443|6443|6555|7443|5443)\s' || echo "⚠️  部分端口未监听，请检查"

  # 生成节点链接
  VLESS_TCP="vless://$UUID@$IP:443?encryption=none&flow=xtls-rprx-vision&security=reality&sni=$SNI&fp=chrome&pbk=$PUB_KEY&sid=$SHORT_ID&type=tcp#Hugo-Reality-TCP"
  VLESS_GP="vless://$UUID@$IP:444?encryption=none&security=reality&sni=$SNI&fp=chrome&pbk=$PUB_KEY&sid=$SHORT_ID&type=grpc&serviceName=hugogrpc#Hugo-Reality-gRPC"
  XTLS_EXTRA="vless://$UUID@$IP:8881?encryption=none&flow=xtls-rprx-vision&security=reality&sni=$SNI&fp=chrome&pbk=$PUB_KEY&sid=$SHORT_ID&type=tcp#Hugo-XTLS-Reality-8881"

  VMESS_JSON="{\"v\":\"2\",\"ps\":\"Hugo-VMess\",\"add\":\"$IP\",\"port\":\"3443\",\"id\":\"$VMESS_UUID\",\"aid\":\"0\",\"scy\":\"auto\",\"net\":\"tcp\",\"type\":\"none\",\"host\":\"\",\"path\":\"\",\"tls\":\"\"}"
  VMESS_LINK="vmess://$(echo -n "$VMESS_JSON" | base64 -w0 2>/dev/null || echo -n "$VMESS_JSON" | base64 | tr -d '\n')"

  ANYTLS_LINK="trojan://$ANYTLS_PASS@$IP:10000?security=tls&allowInsecure=1#Hugo-AnyTLS"
  HY2_LINK="hysteria2://$HY2_PASS@$IP:8443?insecure=1&sni=bing.com#Hugo-Hysteria2"
  TUIC_LINK="tuic://$UUID:$TUIC_PASS@$IP:9443?congestion_control=bbr&alpn=h3&allow_insecure=1#Hugo-TuicV5"
  TROJAN_LINK="trojan://$TROJAN_PASS@$IP:7443?security=tls&allowInsecure=1#Hugo-Trojan"
  SOCKS_LINK="socks://$PROXY_USER:$PROXY_PASS@$IP:5443#Hugo-Socks5-Mixed"

  SS_2022_ENCODED=$(echo -n "2022-blake3-aes-128-gcm:$SS_PASS" | base64 -w0 2>/dev/null || echo -n "2022-blake3-aes-128-gcm:$SS_PASS" | base64 | tr -d '\n')
  SS_LINK="ss://$SS_2022_ENCODED@$IP:6443#Hugo-Shadowsocks-2022"

  SS_CLASSIC_ENCODED=$(echo -n "aes-256-gcm:$SS_CLASSIC_PASS" | base64 -w0 2>/dev/null || echo -n "aes-256-gcm:$SS_CLASSIC_PASS" | base64 | tr -d '\n')
  SS_CLASSIC_LINK="ss://$SS_CLASSIC_ENCODED@$IP:6555#Hugo-Shadowsocks-Classic"

  cat > "$LOG_FILE" << LINKS
