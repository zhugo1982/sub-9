          "short_id": ["$SHORT_ID"]
        }
      }
    },
    {
      "type": "vless",
      "tag": "vless-grpc",
      "listen": "::",
      "listen_port": 444,
      "users": [{"name": "hugo-grpc", "uuid": "$UUID"}],
      "tls": {
        "enabled": true,
        "server_name": "$SNI",
        "reality": {
          "enabled": true,
          "handshake": {"server": "$SNI", "server_port": 443},
          "private_key": "$PRIV_KEY",
          "short_id": ["$SHORT_ID"]
        }
      },
      "transport": {"type": "grpc", "service_name": "hugogrpc"}
    },
    {
      "type": "vless",
      "tag": "xtls-reality-extra",
      "listen": "::",
      "listen_port": 8881,
      "users": [{"name": "hugo-xtls-8881", "uuid": "$UUID", "flow": "xtls-rprx-vision"}],
      "tls": {
        "enabled": true,
        "server_name": "$SNI",
        "reality": {
          "enabled": true,
          "handshake": {"server": "$SNI", "server_port": 443},
          "private_key": "$PRIV_KEY",
          "short_id": ["$SHORT_ID"]
        }
      }
    },
    {
      "type": "vmess",
      "tag": "vmess-in",
      "listen": "::",
      "listen_port": 3443,
      "users": [{"name": "hugo-vmess", "uuid": "$VMESS_UUID", "alterId": 0}]
    },
