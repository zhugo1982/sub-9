#!/bin/bash

# 确保以 root 权限运行
if [ "$EUID" -ne 0 ]; then
  echo "❌ 请使用 root 权限运行此脚本！(例如: sudo bash ...)"
  exit 1
fi

LOG_FILE="/etc/sing-box/sub_links.txt"
SUB_FILE="/etc/sing-box/sub_b64.txt"
SUB_PORT=2082

# 显示当前已保存节点及订阅信息的函数
show_nodes() {
    if [ -f "$LOG_FILE" ]; then
        echo "============================================================"
        echo "✨ 当前服务器已生成的 11 大协议节点信息如下："
        echo "============================================================"
        cat "$LOG_FILE"
        echo ""
        echo "============================================================"
        echo "🔗 网页订阅链接 (可在 V2rayN / Shadowrocket / v2rayNG 等直接添加):"
        echo "   http://$(curl -s https://api.ipify.org || echo "你的IP"):$SUB_PORT/sub"
        echo "🔗 sing-box 客户端 JSON 配置链接："
        echo "   http://$(curl -s https://api.ipify.org || echo "你的IP"):$SUB_PORT/singbox"
        echo "============================================================"
    else
        echo "❌ 未找到已保存的节点信息！请先运行全新部署。"
    fi
}

# 部署并启动轻量级 HTTP 订阅托管服务
setup_sub_service() {
    echo "==> 配置 HTTP 订阅托管服务 (端口: $SUB_PORT)..."
    
    # 确保安装 python3
    if ! command -v python3 &> /dev/null; then
        apt-get update -y && apt-get install -y python3 2>/dev/null || yum install -y python3 2>/dev/null
    fi

    # 编写后台轻量 HTTP 订阅服务脚本
    cat > /etc/sing-box/sub_server.py << 'PYEOF'
import http.server, socketserver, os, json, base64, urllib.parse, re
PORT = 2082
LINKS = "/etc/sing-box/sub_links.txt"
SUB = "/etc/sing-box/sub_b64.txt"

def dec(s):
    s = urllib.parse.unquote(s)
    s += "=" * ((4 - len(s) % 4) % 4)
    return base64.urlsafe_b64decode(s.encode()).decode("utf-8", "replace")

def parse(link):
    link = link.strip()
    scheme = link.split("://", 1)[0].lower()
    tag = urllib.parse.unquote(link.split("#", 1)[1]) if "#" in link else scheme
    if scheme == "vmess":
        o = json.loads(dec(link[8:].split("#")[0]))
        x = {"type":"vmess", "tag":tag, "server":o["add"], "server_port":int(o["port"]), "uuid":o["id"], "security":o.get("scy") or "auto"}
        if str(o.get("tls", "")).lower() == "tls":
            x["tls"] = {"enabled":True, "server_name":o.get("sni") or o.get("host") or o["add"]}
        if o.get("net") == "grpc": x["transport"] = {"type":"grpc", "service_name":o.get("path", "")}
        elif o.get("net") == "ws": x["transport"] = {"type":"ws", "path":o.get("path") or "/"}
        return x
    u = urllib.parse.urlsplit(link); q = urllib.parse.parse_qs(u.query)
    host, port = u.hostname, u.port
    if not host or not port: return None
    if scheme == "vless":
        x = {"type":"vless", "tag":tag, "server":host, "server_port":port, "uuid":urllib.parse.unquote(u.username or "")}
        flow = (q.get("flow") or [""])[0]
        if flow: x["flow"] = flow
        sec = (q.get("security") or [""])[0]
        if sec == "reality":
            x["tls"] = {"enabled":True, "server_name":(q.get("sni") or [host])[0], "utls":{"enabled":True, "fingerprint":(q.get("fp") or ["chrome"])[0]}, "reality":{"enabled":True, "public_key":(q.get("pbk") or [""])[0], "short_id":(q.get("sid") or [""])[0]}}
        elif sec == "tls": x["tls"] = {"enabled":True, "server_name":(q.get("sni") or [host])[0]}
        if (q.get("type") or ["tcp"])[0] == "grpc": x["transport"] = {"type":"grpc", "service_name":(q.get("serviceName") or [""])[0]}
        return x
    if scheme == "trojan":
        return {"type":"trojan", "tag":tag, "server":host, "server_port":port, "password":urllib.parse.unquote(u.username or ""), "tls":{"enabled":True, "server_name":(q.get("sni") or [host])[0], "insecure":(q.get("allowInsecure") or [""])[0].lower() in ("1","true")}}
    if scheme in ("hysteria2", "hy2"):
        return {"type":"hysteria2", "tag":tag, "server":host, "server_port":port, "password":urllib.parse.unquote(u.username or ""), "tls":{"enabled":True, "server_name":(q.get("sni") or [host])[0], "insecure":(q.get("insecure") or [""])[0].lower() in ("1","true")}}
    if scheme == "tuic":
        return {"type":"tuic", "tag":tag, "server":host, "server_port":port, "uuid":urllib.parse.unquote(u.username or ""), "password":urllib.parse.unquote(u.password or ""), "congestion_control":(q.get("congestion_control") or ["bbr"])[0], "tls":{"enabled":True, "server_name":(q.get("sni") or [host])[0], "alpn":(q.get("alpn") or ["h3"])[0].split(","), "insecure":(q.get("allow_insecure") or [""])[0].lower() in ("1","true")}}
    if scheme == "ss":
        ui = u.netloc.rsplit("@", 1)[0]
        try: cred = dec(ui)
        except Exception: cred = urllib.parse.unquote(ui)
        if ":" in cred: method, pw = cred.split(":", 1)
        else: method, pw = (q.get("method") or ["aes-256-gcm"])[0], urllib.parse.unquote(u.username or "")
        return {"type":"shadowsocks", "tag":tag, "server":host, "server_port":port, "method":method, "password":pw}
    if scheme in ("socks", "socks5"):
        x = {"type":"socks", "tag":tag, "server":host, "server_port":port}
        if u.username: x["username"] = urllib.parse.unquote(u.username)
        if u.password: x["password"] = urllib.parse.unquote(u.password)
        return x
    return None

def make_config():
    links = []
    with open(LINKS, encoding="utf-8", errors="replace") as f:
        for line in f:
            line = line.strip()
            if re.match(r"^(vless|vmess|trojan|hysteria2|hy2|tuic|ss|socks|socks5)://", line, re.I): links.append(line)
    outbounds = []
    for link in links:
        try:
            node = parse(link)
            if node: outbounds.append(node)
        except Exception:
            pass
    if not outbounds: raise ValueError("无法从 sub_links.txt 解析节点，请检查原节点链接格式")
    tags = [x["tag"] for x in outbounds]
    outbounds += [{"type":"direct", "tag":"direct"}, {"type":"selector", "tag":"节点选择", "outbounds":tags+["direct"], "default":tags[0]}]
    return {"log":{"level":"info"}, "inbounds":[{"type":"mixed", "tag":"mixed-in", "listen":"127.0.0.1", "listen_port":20808}], "outbounds":outbounds, "route":{"auto_detect_interface":True, "final":"节点选择"}}

class Handler(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        path = self.path.split("?", 1)[0]
        try:
            if path == "/sub":
                with open(SUB, "rb") as f: data = f.read()
                content_type = "text/plain; charset=utf-8"
            elif path in ("/singbox", "/singbox.json"):
                data = json.dumps(make_config(), ensure_ascii=False, indent=2).encode("utf-8")
                content_type = "application/json; charset=utf-8"
            else:
                self.send_error(404, "Not Found"); return
            self.send_response(200); self.send_header("Content-Type", content_type); self.send_header("Content-Length", str(len(data))); self.end_headers(); self.wfile.write(data)
        except Exception as e:
            data = json.dumps({"error":str(e)}, ensure_ascii=False).encode("utf-8")
            self.send_response(500); self.send_header("Content-Type", "application/json; charset=utf-8"); self.send_header("Content-Length", str(len(data))); self.end_headers(); self.wfile.write(data)
    def log_message(self, *args): return

class ThreadedServer(socketserver.ThreadingMixIn, socketserver.TCPServer):
    allow_reuse_address = True
    daemon_threads = True

if __name__ == "__main__":
    with ThreadedServer(("", PORT), Handler) as server: server.serve_forever()
PYEOF

    # 创建 systemd 开机自启服务
    cat > /etc/systemd/system/hugo-sub.service << SERVICEOF
[Unit]
Description=Hugo Sub HTTP Service
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /etc/sing-box/sub_server.py
Restart=always
User=root

[Install]
WantedBy=multi-user.target
SERVICEOF

    systemctl daemon-reload
    systemctl enable hugo-sub
    systemctl restart hugo-sub
    echo "✅ 订阅托管服务已启动！"
}

# 完全卸载/清理函数
uninstall_nodes() {
    echo "============================================================"
    echo "⚠️  警告：此操作将彻底卸载 sing-box、订阅服务并删除所有节点配置！"
    read -p "确定要彻底卸载吗？(y/N): " CONFIRM
    case "$CONFIRM" in
        [yY][eE][sS]|[yY])
            echo "==> 1. 停止并禁用服务..."
            systemctl stop sing-box 2>/dev/null
            systemctl disable sing-box 2>/dev/null
            systemctl stop hugo-sub 2>/dev/null
            systemctl disable hugo-sub 2>/dev/null

            echo "==> 2. 清理配置文件与订阅开机项..."
            rm -rf /etc/sing-box
            rm -f /etc/systemd/system/hugo-sub.service
            systemctl daemon-reload

            echo "==> 3. 卸载 sing-box 软件包..."
            if command -v apt-get &> /dev/null; then
                apt-get purge -y sing-box 2>/dev/null
                apt-get autoremove -y 2>/dev/null
            elif command -v yum &> /dev/null; then
                yum remove -y sing-box 2>/dev/null
            fi

            echo "==> 4. 清理 sub 全局快捷键..."
            rm -f /usr/local/bin/sub

            echo "============================================================"
            echo "✅ 卸载完成！所有节点、订阅 HTTP 服务及残留文件已彻底清理。"
            echo "============================================================"
            exit 0
            ;;
        *)
            echo "❌ 操作已取消。"
            ;;
    esac
}

