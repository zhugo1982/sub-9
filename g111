#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

# Hugo sing-box 管理脚本（修正版）
# 支持 Debian/Ubuntu；安装前请确认云平台安全组已放行对应 TCP/UDP 端口。
# 订阅采用随机令牌路径，但仍建议部署 HTTPS 反向代理，不要将 HTTP 订阅公开分享。

BASE="/etc/sing-box"
LOG_FILE="$BASE/sub_links.txt"
SUB_FILE="$BASE/sub_b64.txt"
SERVER_PY="$BASE/sub_server.py"
SUB_SERVICE="/etc/systemd/system/hugo-sub.service"
SUB_PORT=2082
SUB_TOKEN_FILE="$BASE/sub_token"
CONFIG="$BASE/config.json"
BACKUP_DIR="/root/hugo-sing-box-backup-$(date +%Y%m%d-%H%M%S)"

need_root() {
  if [[ ${EUID:-$(id -u)} -ne 0 ]]; then
    echo "❌ 请使用 root 权限运行：sudo bash $0"
    exit 1
  fi
}

public_ip() {
  local ip=""
  ip="$(curl -4fsS --max-time 5 https://api.ipify.org 2>/dev/null || true)"
  if [[ -z "$ip" ]]; then
    ip="$(curl -4fsS --max-time 5 https://ifconfig.me/ip 2>/dev/null || true)"
  fi
  if [[ -z "$ip" ]]; then
    read -rp "无法自动获取公网 IPv4，请手动输入服务器公网 IP/域名：" ip
  fi
  printf '%s' "$ip"
}

show_nodes() {
  if [[ -f "$LOG_FILE" ]]; then
    echo "============================================================"
    echo "当前保存的节点信息："
    cat "$LOG_FILE"
    echo
    if [[ -s "$SUB_TOKEN_FILE" ]]; then
      local ip token
      ip="$(public_ip)"
      token="$(cat "$SUB_TOKEN_FILE")"
      echo "订阅链接（带随机令牌；仍为 HTTP 明文，建议改用 HTTPS）："
      echo "http://${ip}:${SUB_PORT}/${token}/sub"
    fi
    echo "============================================================"
  else
    echo "❌ 未找到节点信息，请先部署。"
  fi
}

install_deps() {
  if command -v apt-get >/dev/null 2>&1; then
    apt-get update
    DEBIAN_FRONTEND=noninteractive apt-get install -y curl ca-certificates jq openssl python3
  else
    echo "❌ 此脚本当前仅自动支持 Debian/Ubuntu（apt-get）。请在其他系统先安装 curl、jq、openssl、python3 和 sing-box。"
    exit 1
  fi

  if ! command -v sing-box >/dev/null 2>&1; then
    bash <(curl -fsSL https://sing-box.app/deb-install.sh)
  fi
  command -v sing-box >/dev/null 2>&1 || { echo "❌ sing-box 安装失败"; exit 1; }
}

setup_sub_service() {
  local token
  token="$(cat "$SUB_TOKEN_FILE")"
  cat > "$SERVER_PY" <<'PYEOF'
import http.server
import os
import socketserver

PORT = 2082
FILE_PATH = "/etc/sing-box/sub_b64.txt"
TOKEN_PATH = "/etc/sing-box/sub_token"

class Handler(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        try:
            with open(TOKEN_PATH, "r", encoding="utf-8") as f:
                token = f.read().strip()
        except OSError:
            self.send_error(503, "Subscription unavailable")
            return
        if self.path != f"/{token}/sub":
            self.send_error(404, "Not Found")
            return
        try:
            with open(FILE_PATH, "rb") as f:
                body = f.read()
        except OSError:
            self.send_error(404, "Subscription file not found")
            return
        self.send_response(200)
        self.send_header("Content-Type", "text/plain; charset=utf-8")
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, fmt, *args):
        return

class Server(socketserver.ThreadingTCPServer):
    allow_reuse_address = True
    daemon_threads = True

with Server(("0.0.0.0", PORT), Handler) as httpd:
    httpd.serve_forever()
PYEOF
  chmod 600 "$SERVER_PY" "$SUB_FILE" "$SUB_TOKEN_FILE" 2>/dev/null || true

  cat > "$SUB_SERVICE" <<'SERVICEOF'
[Unit]
Description=Hugo sing-box Subscription HTTP Service
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /etc/sing-box/sub_server.py
Restart=on-failure
RestartSec=3
User=root
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/etc/sing-box

[Install]
WantedBy=multi-user.target
SERVICEOF

  systemctl daemon-reload
  systemctl enable --now hugo-sub
  systemctl is-active --quiet hugo-sub || {
    systemctl --no-pager --full status hugo-sub || true
    echo "❌ 订阅服务启动失败"
    return 1
  }
}

install_nodes() {
  install_deps
  mkdir -p "$BASE"
  chmod 700 "$BASE"

  # 备份现有配置和节点信息，避免覆盖后无法回滚。
  if [[ -e "$CONFIG" || -e "$LOG_FILE" ]]; then
    mkdir -p "$BACKUP_DIR"
    cp -a "$BASE"/config.json "$BASE"/sub_links.txt "$BASE"/sub_b64.txt "$BASE"/sub_token "$BACKUP_DIR"/ 2>/dev/null || true
    echo "旧文件备份位置：$BACKUP_DIR"
  fi

  local IP UUID VMESS_UUID ANYTLS_PASS HY2_PASS TUIC_UUID TUIC_PASS
  local SS_PASS SS_CLASSIC_PASS TROJAN_PASS PROXY_USER PROXY_PASS
  local PRIV_KEY PUB_KEY SHORT_ID SNI CERT_KEY CERT_CRT SUB_TOKEN
  IP="$(public_ip)"
  UUID="$(cat /proc/sys/kernel/random/uuid)"
  VMESS_UUID="$(cat /proc/sys/kernel/random/uuid)"
  ANYTLS_PASS="$(openssl rand -hex 24)"
  HY2_PASS="$(openssl rand -hex 16)"
  TUIC_UUID="$(cat /proc/sys/kernel/random/uuid)"
  TUIC_PASS="$(openssl rand -hex 24)"
  SS_PASS="$(openssl rand -base64 16 | tr -d '\n')"
  SS_CLASSIC_PASS="$(openssl rand -hex 24)"
  TROJAN_PASS="$(openssl rand -hex 24)"
  PROXY_USER="hugo"
  PROXY_PASS="$(openssl rand -hex 12)"
  SHORT_ID="$(openssl rand -hex 4)"
  SNI="bing.com"
  CERT_KEY="$BASE/hy2.key"
  CERT_CRT="$BASE/hy2.crt"
  SUB_TOKEN="$(openssl rand -hex 24)"
  printf '%s' "$SUB_TOKEN" > "$SUB_TOKEN_FILE"

  local KEYPAIR
  KEYPAIR="$(sing-box generate reality-keypair)"
  PRIV_KEY="$(awk '/PrivateKey/ {print $2; exit}' <<<"$KEYPAIR")"
  PUB_KEY="$(awk '/PublicKey/ {print $2; exit}' <<<"$KEYPAIR")"
  if [[ -z "$PRIV_KEY" || -z "$PUB_KEY" ]]; then
    echo "❌ 无法生成 Reality 密钥。当前 sing-box 版本输出格式可能不同。"
    exit 1
  fi

  # 该证书用于 TLS 类节点。它是自签名证书，客户端需要跳过验证；正式使用建议换成域名有效证书。
  openssl req -x509 -nodes -newkey rsa:2048 \
    -keyout "$CERT_KEY" -out "$CERT_CRT" -days 825 \
    -subj "/CN=$SNI" >/dev/null 2>&1
  chmod 600 "$CERT_KEY"
  chmod 644 "$CERT_CRT"

  # Shadowsocks 2022 要求对应长度的 Base64 密钥；openssl rand -base64 16 生成 16 字节密钥。
  cat > "$CONFIG.tmp" <<CONFIGEOF
{
  "log": {"level": "info"},
  "inbounds": [
    {
      "type": "vless", "tag": "vless-reality-tcp", "listen": "::", "listen_port": 443,
      "users": [{"name": "hugo-reality", "uuid": "$UUID", "flow": "xtls-rprx-vision"}],
      "tls": {"enabled": true, "server_name": "$SNI",
        "reality": {"enabled": true, "handshake": {"server": "$SNI", "server_port": 443},
          "private_key": "$PRIV_KEY", "short_id": ["$SHORT_ID"]}}
    },
    {
      "type": "vless", "tag": "vless-grpc-tls", "listen": "::", "listen_port": 444,
      "users": [{"name": "hugo-grpc", "uuid": "$UUID"}],
      "tls": {"enabled": true, "certificate_path": "$CERT_CRT", "key_path": "$CERT_KEY"},
      "transport": {"type": "grpc", "service_name": "hugogrpc"}
    },
    {
      "type": "vless", "tag": "vless-reality-extra", "listen": "::", "listen_port": 8881,
      "users": [{"name": "hugo-extra", "uuid": "$UUID", "flow": "xtls-rprx-vision"}],
      "tls": {"enabled": true, "server_name": "$SNI",
        "reality": {"enabled": true, "handshake": {"server": "$SNI", "server_port": 443},
          "private_key": "$PRIV_KEY", "short_id": ["$SHORT_ID"]}}
    },
    {
      "type": "vmess", "tag": "vmess-in", "listen": "::", "listen_port": 3443,
      "users": [{"name": "hugo-vmess", "uuid": "$VMESS_UUID", "alterId": 0}]
    },
    {
      "type": "anytls", "tag": "anytls-in", "listen": "::", "listen_port": 10000,
      "users": [{"name": "hugo-anytls", "password": "$ANYTLS_PASS"}],
      "tls": {"enabled": true, "certificate_path": "$CERT_CRT", "key_path": "$CERT_KEY"}
    },
    {
      "type": "hysteria2", "tag": "hy2-in", "listen": "::", "listen_port": 8443,
      "users": [{"name": "hugo-hy2", "password": "$HY2_PASS"}],
      "masquerade": "https://bing.com",
      "tls": {"enabled": true, "alpn": ["h3"], "certificate_path": "$CERT_CRT", "key_path": "$CERT_KEY"}
    },
    {
      "type": "tuic", "tag": "tuic-in", "listen": "::", "listen_port": 9443,
      "users": [{"name": "hugo-tuic", "uuid": "$TUIC_UUID", "password": "$TUIC_PASS"}],
      "congestion_control": "bbr", "tls": {"enabled": true, "alpn": ["h3"],
        "certificate_path": "$CERT_CRT", "key_path": "$CERT_KEY"}
    },
    {
      "type": "shadowsocks", "tag": "ss-2022-in", "listen": "::", "listen_port": 6443,
      "method": "2022-blake3-aes-128-gcm", "password": "$SS_PASS"
    },
    {
      "type": "shadowsocks", "tag": "ss-classic-in", "listen": "::", "listen_port": 6555,
      "method": "aes-256-gcm", "password": "$SS_CLASSIC_PASS"
    },
    {
      "type": "trojan", "tag": "trojan-in", "listen": "::", "listen_port": 7443,
      "users": [{"name": "hugo-trojan", "password": "$TROJAN_PASS"}],
      "tls": {"enabled": true, "certificate_path": "$CERT_CRT", "key_path": "$CERT_KEY"}
    },
    {
      "type": "socks", "tag": "socks-in", "listen": "0.0.0.0", "listen_port": 5443,
      "users": [{"username": "$PROXY_USER", "password": "$PROXY_PASS"}]
    }
  ],
  "outbounds": [{"type": "direct", "tag": "direct"}]
}
CONFIGEOF

  # 不覆盖现有配置，直到新配置通过当前 sing-box 校验。
  if ! sing-box check -c "$CONFIG.tmp"; then
    echo "❌ 新配置校验失败；原配置未覆盖。错误信息见上方。"
    rm -f "$CONFIG.tmp"
    exit 1
  fi
  install -m 600 "$CONFIG.tmp" "$CONFIG"
  rm -f "$CONFIG.tmp"

  local VLESS_TCP VLESS_GRPC XTLS_EXTRA VMESS_JSON VMESS_LINK ANYTLS_LINK HY2_LINK TUIC_LINK
  local SS_LINK SS_CLASSIC_LINK TROJAN_LINK MIXED_LINK
  VLESS_TCP="vless://${UUID}@${IP}:443?encryption=none&flow=xtls-rprx-vision&security=reality&sni=${SNI}&fp=chrome&pbk=${PUB_KEY}&sid=${SHORT_ID}&type=tcp#Hugo-Reality-TCP"
  # gRPC 节点使用 TLS 自签名证书，不使用 Reality；部分客户端需手动开启跳过证书验证。
  VLESS_GRPC="vless://${UUID}@${IP}:444?encryption=none&security=tls&sni=${SNI}&type=grpc&serviceName=hugogrpc&allowInsecure=1#Hugo-VLESS-gRPC-TLS"
  XTLS_EXTRA="vless://${UUID}@${IP}:8881?encryption=none&flow=xtls-rprx-vision&security=reality&sni=${SNI}&fp=chrome&pbk=${PUB_KEY}&sid=${SHORT_ID}&type=tcp#Hugo-Reality-8881"
  VMESS_JSON="$(jq -cn --arg ip "$IP" --arg id "$VMESS_UUID" \
    '{v:"2",ps:"Hugo-VMess",add:$ip,port:"3443",id:$id,aid:"0",scy:"auto",net:"tcp",type:"none",host:"",path:"",tls:""}')"
  VMESS_LINK="vmess://$(printf '%s' "$VMESS_JSON" | base64 -w 0)"
  ANYTLS_LINK="anytls://${ANYTLS_PASS}@${IP}:10000/?sni=${SNI}&insecure=1#Hugo-AnyTLS"
  HY2_LINK="hysteria2://${HY2_PASS}@${IP}:8443/?insecure=1&sni=${SNI}#Hugo-Hysteria2"
  TUIC_LINK="tuic://${TUIC_UUID}:${TUIC_PASS}@${IP}:9443?congestion_control=bbr&alpn=h3&allow_insecure=1#Hugo-TUIC"
  SS_LINK="ss://$(printf '2022-blake3-aes-128-gcm:%s' "$SS_PASS" | base64 -w 0)@${IP}:6443#Hugo-Shadowsocks-2022"
  SS_CLASSIC_LINK="ss://$(printf 'aes-256-gcm:%s' "$SS_CLASSIC_PASS" | base64 -w 0)@${IP}:6555#Hugo-Shadowsocks-Classic"
  TROJAN_LINK="trojan://${TROJAN_PASS}@${IP}:7443?security=tls&sni=${SNI}&allowInsecure=1#Hugo-Trojan"
  MIXED_LINK="socks5://${PROXY_USER}:${PROXY_PASS}@${IP}:5443#Hugo-SOCKS5"

  cat > "$LOG_FILE" <<LINKS
[1] VLESS-Reality-TCP (443)
$VLESS_TCP
------------------------------------------------------------
[2] VLESS-gRPC-TLS (444)
$VLESS_GRPC
------------------------------------------------------------
[3] VLESS-Reality-Extra (8881)
$XTLS_EXTRA
------------------------------------------------------------
[4] VMess (3443)
$VMESS_LINK
------------------------------------------------------------
[5] AnyTLS (10000)
$ANYTLS_LINK
------------------------------------------------------------
[6] Hysteria 2 (8443/UDP)
$HY2_LINK
------------------------------------------------------------
[7] TUIC (9443/UDP)
$TUIC_LINK
------------------------------------------------------------
[8] Shadowsocks 2022 (6443)
$SS_LINK
------------------------------------------------------------
[9] Shadowsocks Classic (6555)
$SS_CLASSIC_LINK
------------------------------------------------------------
[10] Trojan (7443)
$TROJAN_LINK
------------------------------------------------------------
[11] SOCKS5 (5443)
$MIXED_LINK
============================================================
LINKS

  printf '%s\n' "$VLESS_TCP" "$VLESS_GRPC" "$XTLS_EXTRA" "$VMESS_LINK" \
    "$ANYTLS_LINK" "$HY2_LINK" "$TUIC_LINK" "$SS_LINK" "$SS_CLASSIC_LINK" \
    "$TROJAN_LINK" "$MIXED_LINK" | base64 -w 0 > "$SUB_FILE"
  chmod 600 "$LOG_FILE" "$SUB_FILE" "$SUB_TOKEN_FILE"

  # 配置通过后再重启；若启动失败，输出日志供排查。
  systemctl enable sing-box
  if ! systemctl restart sing-box; then
    echo "❌ sing-box 启动失败，最近日志如下："
    journalctl -u sing-box -n 80 --no-pager || true
    echo "配置文件保存在 $CONFIG；旧文件备份在 $BACKUP_DIR（如有）。"
    exit 1
  fi
  if ! systemctl is-active --quiet sing-box; then
    journalctl -u sing-box -n 80 --no-pager || true
    echo "❌ sing-box 未处于 active 状态。"
    exit 1
  fi

  setup_sub_service
  echo "✅ 部署完成：配置校验和服务启动均已通过。"
  echo "注意：请在云平台安全组/防火墙放行节点端口；Hysteria2、TUIC 需要 UDP。"
  show_nodes
}

uninstall_nodes() {
  echo "⚠️ 将停止服务并删除 sing-box 配置、节点凭证和订阅服务。"
  read -rp "输入 DELETE 确认卸载：" confirm
  [[ "$confirm" == "DELETE" ]] || { echo "已取消。"; return; }

  if [[ -d "$BASE" ]]; then
    mkdir -p "$BACKUP_DIR"
    cp -a "$BASE" "$BACKUP_DIR/" 2>/dev/null || true
    echo "已尝试备份至：$BACKUP_DIR"
  fi

  systemctl disable --now sing-box 2>/dev/null || true
  systemctl disable --now hugo-sub 2>/dev/null || true
  rm -f "$SUB_SERVICE"
  systemctl daemon-reload
  if command -v apt-get >/dev/null 2>&1; then
    apt-get purge -y sing-box || true
    apt-get autoremove -y || true
  fi
  # 配置目录先备份，再删除；请确认其中没有其他服务需要的文件。
  rm -rf "$BASE"
  rm -f /usr/local/bin/sub
  echo "卸载完成。备份目录（若创建成功）：$BACKUP_DIR"
}

menu() {
  echo "============================================================"
  echo "          Hugo sing-box 多协议管理脚本"
  echo "============================================================"
  echo "  1. 查看当前节点信息及订阅链接"
  echo "  2. 全新部署 / 重置 11 个节点"
  echo "  3. 卸载 sing-box 及清理服务"
  echo "  0. 退出"
  echo "============================================================"
  read -rp "请输入数字 [0-3]：" choice
  case "$choice" in
    1) show_nodes ;;
    2) install_nodes ;;
    3) uninstall_nodes ;;
    0) exit 0 ;;
    *) echo "❌ 无效输入"; exit 1 ;;
  esac
}

need_root
case "${1:-}" in
  install|2) install_nodes ;;
  uninstall|3) uninstall_nodes ;;
  "" ) menu ;;
  *) echo "用法：$0 [install|2|uninstall|3]"; exit 2 ;;
esac
