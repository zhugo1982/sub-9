$TROJAN_LINK
------------------------------------------------------------
[11] SOCKS5/HTTP Mixed (5443):
$SOCKS_LINK
============================================================
LINKS

  # Base64 订阅
  RAW_SUBS="$VLESS_TCP
$VLESS_GP
$XTLS_EXTRA
$VMESS_LINK
$ANYTLS_LINK
$HY2_LINK
$TUIC_LINK
$SS_LINK
$SS_CLASSIC_LINK
$TROJAN_LINK
$SOCKS_LINK"
  echo -n "$RAW_SUBS" | base64 -w0 2>/dev/null > "$SUB_FILE" || echo -n "$RAW_SUBS" | base64 | tr -d '\n' > "$SUB_FILE"

  # Apple sing-box JSON 订阅
  cat > "$SB_JSON_FILE" << SBJSON
