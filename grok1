      "listen_port": 443,
      "users": [{"name": "hugo-tcp", "uuid": "$UUID", "flow": "xtls-rprx-vision"}],
      "tls": {
        "enabled": true,
        "server_name": "$SNI",
        "reality": {
          "enabled": true,
          "handshake": {"server": "$SNI", "server_port": 443},
          "private_key": "$PRIV_KEY",
          "short_id": ["$SHORT_ID"]
        }
      }
    },
    {
      "type": "vless",
      "tag": "vless-grpc",
      "listen": "0.0.0.0",
      "listen_port": 444,
      "users": [{"name": "hugo-grpc", "uuid": "$UUID"}],
      "tls": {
        "enabled": true,
        "server_name": "$SNI",
        "reality": {
          "enabled": true,
          "handshake": {"server": "$SNI", "server_port": 443},
          "private_key": "$PRIV_KEY",
          "short_id": ["$SHORT_ID"]
        }
      },
      "transport": {"type": "grpc", "service_name": "hugogrpc"}
    },
    {
      "type": "vless",
      "tag": "xtls-reality-extra",
      "listen": "0.0.0.0",
      "listen_port": 8881,
      "users": [{"name": "hugo-xtls-8881", "uuid": "$UUID", "flow": "xtls-rprx-vision"}],
      "tls": {
        "enabled": true,
        "server_name": "$SNI",
        "reality": {
          "enabled": true,
          "handshake": {"server": "$SNI", "server_port": 443},
          "private_key": "$PRIV_KEY",
          "short_id": ["$SHORT_ID"]
        }
      }
    },
    {
      "type": "vmess",
      "tag": "vmess-in",
      "listen": "0.0.0.0",
      "listen_port": 3443,
      "users": [{"name": "hugo-vmess", "uuid": "$VMESS_UUID", "alterId": 0}]
    },
    {
      "type": "trojan",
      "tag": "anytls-in",
      "listen": "0.0.0.0",
      "listen_port": 10000,
      "users": [{"name": "hugo-anytls", "password": "$ANYTLS_PASS"}],
      "tls": {
        "enabled": true,
        "certificate_path": "/etc/sing-box/hy2.crt",
        "key_path": "/etc/sing-box/hy2.key"
      }
    },
    {
      "type": "hysteria2",
      "tag": "hy2-in",
      "listen": "0.0.0.0",
      "listen_port": 8443,
      "users": [{"password": "$HY2_PASS"}],
      "masquerade": "https://bing.com",
      "tls": {
        "enabled": true,
        "alpn": ["h3"],
        "certificate_path": "/etc/sing-box/hy2.crt",
        "key_path": "/etc/sing-box/hy2.key"
      }
    },
    {
      "type": "tuic",
      "tag": "tuic-in",
      "listen": "0.0.0.0",
      "listen_port": 9443,
      "users": [{"uuid": "$UUID", "password": "$TUIC_PASS"}],
      "congestion_control": "bbr",
      "tls": {
        "enabled": true,
        "alpn": ["h3"],
        "certificate_path": "/etc/sing-box/hy2.crt",
        "key_path": "/etc/sing-box/hy2.key"
      }
    },
    {
      "type": "shadowsocks",
      "tag": "ss-2022-in",
      "listen": "0.0.0.0",
      "listen_port": 6443,
      "method": "2022-blake3-aes-128-gcm",
      "password": "$SS_PASS"
    },
    {
      "type": "shadowsocks",
      "tag": "ss-classic-in",
      "listen": "0.0.0.0",
      "listen_port": 6555,
      "method": "aes-256-gcm",
      "password": "$SS_CLASSIC_PASS"
    },
    {
      "type": "trojan",
      "tag": "trojan-in",
      "listen": "0.0.0.0",
      "listen_port": 7443,
      "users": [{"name": "hugo-trojan", "password": "$TROJAN_PASS"}],
      "tls": {
        "enabled": true,
        "certificate_path": "/etc/sing-box/hy2.crt",
        "key_path": "/etc/sing-box/hy2.key"
      }
    },
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "0.0.0.0",
      "listen_port": 5443,
      "users": [{"username": "$PROXY_USER", "password": "$PROXY_PASS"}]
