#!/bin/bash
# Hugo sing-box 11协议一键管理脚本

if [ "$EUID" -ne 0 ]; then
  echo "❌ 请使用 root 权限运行！(sudo bash ...)"
  exit 1
fi

LOG_FILE="/etc/sing-box/sub_links.txt"
SUB_FILE="/etc/sing-box/sub_b64.txt"
SB_JSON_FILE="/etc/sing-box/sub_singbox.json"
SUB_PORT=2082

show_nodes() {
  if [ -f "$LOG_FILE" ]; then
    echo "============================================================"
    echo "✨ 当前服务器已生成的 11 大协议节点信息如下："
    echo "============================================================"
    cat "$LOG_FILE"
    echo ""
    echo "============================================================"
    echo "🔗 通用订阅链接 (V2rayN / Shadowrocket / v2rayNG 等):"
    echo "   http://$(curl -s https://api.ipify.org || echo "你的IP"):$SUB_PORT/sub"
    echo ""
    echo "🍎 Apple / sing-box 专用 JSON 订阅 (SFI / SFM / sing-box VT):"
    echo "   http://$(curl -s https://api.ipify.org || echo "你的IP"):$SUB_PORT/singbox"
    echo "============================================================"
  else
    echo "❌ 未找到节点信息！请先运行全新部署。"
  fi
}

setup_sub_service() {
  echo "==> 配置 HTTP 订阅服务 (端口 $SUB_PORT)..."
  if ! command -v python3 &>/dev/null; then
    apt-get update -y && apt-get install -y python3 2>/dev/null || yum install -y python3 2>/dev/null
  fi

  cat > /etc/sing-box/sub_server.py << 'PY'
import http.server, socketserver, os
PORT = 2082
class H(http.server.SimpleHTTPRequestHandler):
    def do_GET(self):
        if self.path == '/sub':
            f = "/etc/sing-box/sub_b64.txt"
            if os.path.exists(f):
                self.send_response(200)
                self.send_header('Content-type', 'text/plain; charset=utf-8')
                self.end_headers()
                self.wfile.write(open(f,'rb').read())
            else:
                self.send_error(404)
        elif self.path in ('/singbox','/sb'):
            f = "/etc/sing-box/sub_singbox.json"
            if os.path.exists(f):
                self.send_response(200)
                self.send_header('Content-type', 'application/json; charset=utf-8')
                self.end_headers()
                self.wfile.write(open(f,'rb').read())
            else:
                self.send_error(404)
        else:
            self.send_error(403)
    def log_message(self, *a): pass
if __name__ == "__main__":
    socketserver.TCPServer.allow_reuse_address = True
    with socketserver.TCPServer(("", PORT), H) as httpd:
        httpd.serve_forever()
PY

  cat > /etc/systemd/system/hugo-sub.service << 'SVC'
[Unit]
Description=Hugo Sub HTTP Service
After=network.target
[Service]
Type=simple
ExecStart=/usr/bin/python3 /etc/sing-box/sub_server.py
Restart=always
User=root
[Install]
WantedBy=multi-user.target
SVC

  systemctl daemon-reload
  systemctl enable hugo-sub --now
  echo "✅ 订阅服务已启动"
}

uninstall_nodes() {
  echo "============================================================"
  echo "⚠️  警告：将彻底卸载 sing-box 和所有节点！"
  read -p "确定卸载吗？(y/N): " c
  case "$c" in
    [yY]|[yY][eE][sS])
      systemctl stop sing-box hugo-sub 2>/dev/null
      systemctl disable sing-box hugo-sub 2>/dev/null
      rm -rf /etc/sing-box
      rm -f /etc/systemd/system/hugo-sub.service
      systemctl daemon-reload
      if command -v apt-get &>/dev/null; then
        apt-get purge -y sing-box 2>/dev/null
        apt-get autoremove -y 2>/dev/null
      elif command -v yum &>/dev/null; then
        yum remove -y sing-box 2>/dev/null
      fi
      rm -f /usr/local/bin/sub
      echo "✅ 卸载完成"
      exit 0
      ;;
    *) echo "已取消" ;;
  esac
}

install_nodes() {
  echo "==> 0. 检查并安装 sing-box..."
  if ! command -v sing-box &>/dev/null; then
    apt-get update -y && apt-get install -y curl wget jq openssl python3
    bash <(curl -fsSL https://sing-box.app/deb-install.sh)
    echo "✅ sing-box 安装完成"
  else
    echo "✅ sing-box 已存在"
  fi

  echo "==> 1. 停止旧服务..."
  systemctl stop sing-box 2>/dev/null

  echo "==> 2. 生成凭证..."
  mkdir -p /etc/sing-box

  KEYPAIR=$(sing-box generate reality-keypair)
  PRIV_KEY=$(echo "$KEYPAIR" | grep PrivateKey | awk '{print $2}')
  PUB_KEY=$(echo "$KEYPAIR" | grep PublicKey | awk '{print $2}')

  UUID=$(cat /proc/sys/kernel/random/uuid)
  VMESS_UUID=$(cat /proc/sys/kernel/random/uuid)
  ANYTLS_PASS=$(cat /proc/sys/kernel/random/uuid)
  HY2_PASS=$(cat /proc/sys/kernel/random/uuid | cut -d- -f1)
  TUIC_PASS=$(cat /proc/sys/kernel/random/uuid)
  SS_PASS=$(openssl rand -base64 16)
  SS_CLASSIC_PASS=$(openssl rand -base64 16)
  TROJAN_PASS=$(cat /proc/sys/kernel/random/uuid | cut -d- -f1)
  PROXY_USER="hugo"
  PROXY_PASS=$(openssl rand -hex 6)
  SHORT_ID="0123456789abcdef"
  SNI="gateway.icloud.com"

  IP=$(curl -s https://api.ipify.org)
  [ -z "$IP" ] && IP="127.0.0.1"

  echo "==> 3. 写入配置文件..."
  cat > /etc/sing-box/config.json << EOF
